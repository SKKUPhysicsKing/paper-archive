{
  "name": "paper-archive",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, local-first paper library and paired PDF reader.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env PAPER_ARCHIVE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run build",
    "dist:win": "npm run check && electron-builder --win nsis portable",
    "dist:mac": "npm run check && electron-builder --mac dmg",
    "dist:linux": "npm run check && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "kr.ac.skku.paperarchive",
    "productName": "Paper Archive",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
